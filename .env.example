# Harmonie IT Academy — variables d'environnement (aucune valeur réelle ici).
# Copier en .env.local pour le développement. En production, les saisir dans Vercel (Production et Preview séparément).

# URL publique de l'application (sans barre finale)
APP_URL=http://localhost:3000

# PostgreSQL. En production : URL « pooled » de Neon (-pooler dans l'hôte).
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/harmonie
# Facultatif : URL directe (sans pooler) utilisée par les migrations.
DATABASE_URL_UNPOOLED=

# Secret d'authentification, 32 caractères minimum : openssl rand -base64 36
BETTER_AUTH_SECRET=

# Compte administrateur créé au déploiement (facultatif ; voir scripts/ensure-admin.ts).
# Adresse déjà vérifiée, rôle super_admin. ADMIN_PASSWORD est réappliqué à chaque déploiement : le retirer une fois connecté.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# E-mails transactionnels (obligatoire en production)
RESEND_API_KEY=
EMAIL_FROM="Harmonie IT Academy <no-reply@votre-domaine.fr>"
# 1 = enregistrer les e-mails dans la table dev_outbox (ignoré en production)
EMAIL_DEV_OUTBOX=1

# Connexion Google / Microsoft (facultatif : le bouton n'apparaît que si configuré)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Stripe : clés de TEST en développement et en Preview, clés LIVE uniquement en Production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tuteur IA (facultatif, désactivé si vide)
ANTHROPIC_API_KEY=
AI_TUTOR_MODEL=claude-haiku-5-5

# Stockage des fichiers : local (développement uniquement) ou s3 (Cloudflare R2 ou compatible)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Développement uniquement : assouplit la limitation de débit de Better Auth pour les tests automatisés
HIA_RELAX_RATE_LIMIT=0
